{
  "name": "bird-lsp",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:quick": "turbo run test:quick",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "coverage": "turbo run coverage",
    "tegami": "node tools/tegami.mjs",
    "release:version": "node tools/version-packages.mjs",
    "release:status": "node tools/release-status.mjs",
    "release:publish": "pnpm build && pnpm tegami publish",
    "build:parser-wasm:remote": "node tools/build-parser-wasm-remote.mjs",
    "sync:config-examples": "node tools/sync-config-examples.mjs",
    "sync:config-examples:check": "node tools/sync-config-examples.mjs --check",
    "sync:readme-acknowledgements": "node tools/sync-readme-acknowledgements.mjs",
    "sync:readme-acknowledgements:check": "node tools/sync-readme-acknowledgements.mjs --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "tree-sitter-cli"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@j178/prek": "^0.3.4",
    "@types/node": "^24.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vscode/vsce": "4.1.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.51.0",
    "ovsx": "1.3.0",
    "tinyglobby": "0.2.17",
    "tegami": "1.5.0",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
